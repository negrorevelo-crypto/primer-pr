# Configure these as environment variables for the PHP site in Plesk.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chelart_quotes
DB_USER=chelart_app
DB_PASSWORD=replace-with-a-strong-password

# Plesk's PHP mail transport queues new quote alerts to this address.
QUOTE_NOTIFY_EMAIL=chelartusa@gmail.com
QUOTE_MAIL_FROM=website@chelartconstruction.revelco.com.co

# Private request-history portal. Store a password_hash() result, never a plain password.
QUOTE_ADMIN_USERNAME=chelart-admin
QUOTE_ADMIN_PASSWORD_HASH=replace-with-a-password-hash
QUOTE_ADMIN_URL=https://chelartconstruction.revelco.com.co/admin/

