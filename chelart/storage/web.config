<?xml version="1.0" encoding="UTF-8"?>
<!-- Carpeta privada: nunca debe servirse por la web (IIS / Plesk Windows). -->
<configuration>
  <system.webServer>
    <security>
      <authorization>
        <remove users="*" roles="" verbs="" />
        <add accessType="Deny" users="*" />
      </authorization>
    </security>
  </system.webServer>
</configuration>
